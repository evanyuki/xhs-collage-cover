  "content": {
    "cover": {
      "english": "FIELD\nNOTES",
      "place": "公园",
      "strap": "去公园，做一次自然观察",
      "observers": "assets/reference-art/field-hero.png"
    },
    "sections": [
      {
        "section": "三站观察",
        "notesHeading": "带走一页记录",
        "notes": "写下日期、地点和天气。\n挑一个最小的发现画下来，在旁边标出你亲眼看到的细节。",
        "stops": [
          {
            "label": "01",
            "title": "从树下开始",
            "body": "找一棵低枝的树，从枝尖往回看。记下芽的位置、颜色和朝向。"
          },
          {
            "label": "02",
            "title": "在草地边停一分钟",
            "body": "站在步道上听一会儿，把最近和最远的两种声音各写成一个词。"
          },
          {
            "label": "03",
            "title": "沿同一条路返回",
            "body": "再看一次来时留意的地方，补画一个刚才漏掉的细节。"
          }
        ]
      }
    ]
